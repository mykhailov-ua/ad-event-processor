deploy/geoip/*.mmdb
**/*.mmdb
**/*.wasm
**/*.woff
**/*.woff2
**/*.ttf
**/*.eot

# Binary media (no value in code context)
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.ico
**/*.bmp
**/*.tiff
**/*.svg
**/*.mp4
