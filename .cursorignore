# .cursorignore - paths Cursor should not index for AI context (token / clutter control).
# Mirrors .gitignore where sensible; adds generated, binary, and rarely-edited bulk.
# Agents can still open ignored paths explicitly via Read/@ when needed.
# Remove a section temporarily when working in that area.

# Secrets, credentials, local env
.env
.env.secrets
.env.local
.env.*.local
*.env
!/.env.example
!/.env.load-test
install.compose.env
deploy/compose/.env.load-test.runtime
deploy/installer/install.env
deploy/**/nic-tune.env
license.jwt
license.jwt/
.license-*.jwt
var/license.jwt
deploy/vendor/license_private.key
deploy/vendor/trial_registry.json
deploy/vendor/keys/*/license_private.key

# TLS private keys and certs (sources: deploy/nginx/certs/generate-dev-certs.sh)
deploy/nginx/certs/*.key
deploy/nginx/certs/*.crt
deploy/nginx/certs/*.pem

# Build output, vendored deps, compiled binaries
bin/
dist/
vendor/
node_modules/
web/dist/

# Root-level go build -o artifacts (canonical: bin/)
/*.exe
/*-xdp
/tracker
/processor
/control
/management
/auth
/payment
/billing
/notifier
/ivt-detector
/fraud-scorer
/broker
/region-proxy
/log-shipper
/loadgen
/edge-xdp

# Object files, static libs, shared libs
*.o
*.a
*.so
*.so.*
*.dylib
*.dll

# Archives and installers
*.zip
*.tar
*.tar.gz
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.deb
*.rpm
*.dmg
*.pkg
*.msi
*.apk
*.jar
*.war

# Generated code (make gen / make proto / bpf2go / sqlc - edit sources only)
/api/gen/
/gen/

# sqlc (sources: queries/*.sql, migrations/*.sql)
internal/*/db/*.sql.go
internal/*/db/db.go
internal/*/db/models.go
internal/*/db/querier.go
internal/domain/db/

# protobuf / vtproto (sources: api/*.proto)
internal/*/pb/*.pb.go
internal/*/pb/*_grpc.pb.go
internal/*/pb/*_vtproto.pb.go

# bpf2go (sources: deploy/edge-xdp/bpf/*.c, deploy/edge/xdp/bpf/*.c)
internal/edge/bpf_edge_bpf*.go
internal/edge/*.o
deploy/edge/xdp/bpf/*.o
deploy/edge/xdp/bpf/*.disasm.txt
deploy/dev/bpf/*.o
deploy/dev/bpf/*.disasm.txt

# OpenAPI bundle (sources: api/openapi/openapi.yaml + components/ + paths/)
api/openapi/openapi.bundle.yaml

# Rendered deploy configs
**/*.rendered.yaml
**/*.rendered.yml
deploy/monitoring/*.rendered.yaml
deploy/ingress/caddy/generated/*
!deploy/ingress/caddy/generated/.gitkeep

# Rendered load-test nginx/prometheus/grafana (sources: *.load-test.*.in)
deploy/nginx/nginx.load-test.conf
deploy/nginx/lua/edge-tracker-peers.load-test.lua
deploy/monitoring/prometheus.load-test.yaml
deploy/monitoring/grafana-provisioning/datasources/datasource.load-test.yaml

# Lock files and dependency checksum blobs (go.mod / package.json are enough)
go.sum
**/package-lock.json
**/pnpm-lock.yaml
**/yarn.lock
**/bun.lock
**/bun.lockb
**/Cargo.lock
**/poetry.lock
**/Pipfile.lock
**/uv.lock

# Python / ML runtime and caches (sources: model/train, model/eval, model/tests)
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/.Python
.venv/
venv/
.venv-ml/
**/.venv/
**/.ruff_cache/
**/.pytest_cache/
**/.mypy_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.ipynb_checkpoints/
model/.venv/

