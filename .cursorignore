# IDE, editor swap files, OS junk
.idea/
.vscode/
*~
*.swp
*.swo
.#*
#*#
.DS_Store
Thumbs.db
Desktop.ini

# Bulk schema / migration history (rarely needed in default context)
# Remove lines when editing schema or migrations.
internal/*/migrations/
deploy/schemas/

# Grafana dashboard JSON (sources: hand-edited panels; large JSON noise)
deploy/monitoring/grafana-provisioning/dashboards/*.json

# Git internals (never useful in agent context)
.git/
