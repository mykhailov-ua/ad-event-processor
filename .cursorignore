var/fraudscore/
**/*.onnx
**/*.pt
**/*.pth
**/*.h5
**/*.keras
**/*.safetensors
**/*.ckpt
**/*.lgb
**/*.lightgbm
**/*.joblib
**/*.pickle
**/*.pkl

