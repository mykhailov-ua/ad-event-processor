var/
.cache/
coverage/
coverage.out
coverage.html
*.coverprofile
*.prof
*.test
*.trace
trace.out
*.log

# Root runtime scratch
/*.txt
campaigns_replica.json
campaigns_replica.json.tmp
.license-spool/
*.wal

