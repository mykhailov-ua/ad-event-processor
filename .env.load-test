# Load-test / constrained stack ports (sole numeric source for lab overlay).
# Scripts: scripts/lib/load_test_env.sh  Templates: deploy/**/*.load-test.*.in

LOAD_TEST_EDGE_PORT=8000
LOAD_TEST_PROCESSOR_PORT=8500
LOAD_TEST_CONTROL_PORT=8800
LOAD_TEST_PROMETHEUS_PORT=7000
LOAD_TEST_ALERTMANAGER_PORT=7100

LOAD_TEST_TRACKER_COUNT=4
LOAD_TEST_CONSTRAINED_TRACKERS=2
LOAD_TEST_TRACKER_INGEST_BASE=8100
LOAD_TEST_TRACKER_INGEST_STEP=100
LOAD_TEST_TRACKER_METRICS_BASE=9100
LOAD_TEST_TRACKER_METRICS_STEP=100

LOAD_TEST_REDIS_BASE=6400
LOAD_TEST_REDIS_STEP=10
LOAD_TEST_REDIS_SHARDS=6
# Trackers share ad_event_processor_run with Redis; UDS addrs avoid TCP connect() on hot path.
LOAD_TEST_REDIS_USE_UDS=1
