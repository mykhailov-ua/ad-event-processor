# Reference template — runtime file is deploy/ingress/caddy/generated/Caddyfile
# Generate: bash scripts/install/render_ingress.sh
# On-demand TLS: INGRESS_TLS_MODE=on_demand CADDY_ACME_EMAIL=ops@example.com bash scripts/install/render_ingress.sh

{
	email {$CADDY_ACME_EMAIL}
	# RP-M4: enable with INGRESS_TLS_MODE=on_demand in render_ingress.sh
	# on_demand_tls {
	# 	ask http://127.0.0.1:8188/api/v1/ops/domains/tls-allowed?token=...
	# 	interval 2m
	# 	burst 5
	# }
}

# Static mode (default INGRESS_TLS_MODE=acme):
{$TRACKING_DOMAIN} {
	reverse_proxy 127.0.0.1:8181
}

{$ADMIN_DOMAIN} {
	reverse_proxy 127.0.0.1:8188
}

# On-demand mode (:443 catch-all) — see render_ingress.sh when INGRESS_TLS_MODE=on_demand
