# Ingress network interface for XDP and packet reception tuning.
# If left empty, the script auto-detects the interface bound to the default route.
INGRESS_INTERFACE=eth0

# IRQ strategy to bind queue interrupts to CPU cores.
# Options:
#  - auto: use system irqbalance if available, fallback to manual spread (default)
#  - irqbalance: force starting the OS irqbalance daemon
#  - spread: force manual round-robin distribution across all CPU cores
IRQ_STRATEGY=auto

# Dry-run mode. If set to 1, prints changes without modifying hardware parameters.
DRY_RUN=0
