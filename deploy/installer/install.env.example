# ==============================================================================
# ad-event-processor Installer Environment Configuration Example
# ==============================================================================

# Bootstrap credentials for the initial admin/operator account
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# Enterprise License Configuration
# Mode options: "file" (looks for var/license.jwt) or "env" (looks for AD_EVENT_PROCESSOR_LICENSE_KEY value)
AD_EVENT_PROCESSOR_LICENSE_MODE=file
AD_EVENT_PROCESSOR_LICENSE_KEY=
AD_EVENT_PROCESSOR_LICENSE_REQUIRED=1

# Core Tracking and Billing Parameters
TRACKING_DOMAIN=trk.example.com
ADMIN_DOMAIN=admin.example.com
DEFAULT_CURRENCY=USD
TIMEZONE=UTC

# Global Telemetry/Metrics Collection status
TELEMETRY_ENABLED=false

# Ingress Controller Config
# Set to 1 to deploy local Nginx/OpenResty edge proxy, 0 to skip
INGRESS_ENABLED=0
CADDY_ACME_EMAIL=ops@example.com

# TLS Configuration
# Options: "acme" (automated Let's Encrypt certificates) or "custom" (uses manual paths below)
INGRESS_TLS_MODE=acme
INGRESS_TLS_CERT=/etc/caddy/certs/fullchain.pem
INGRESS_TLS_KEY=/etc/caddy/certs/privkey.pem

# Stripe integration (for self-serve developer credit payments)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
