# ad-event-processor Installer Environment Configuration Example
# Default install: sudo bash install.sh systemd up  ->  open http://<ip>:8188/activate
# Do not set ADMIN_BOOTSTRAP_* unless AD_EVENT_PROCESSOR_CLI_BOOTSTRAP=1 below.

# CLI-only bootstrap (off by default). When 1, set ADMIN_BOOTSTRAP_EMAIL/PASSWORD and license here.
AD_EVENT_PROCESSOR_CLI_BOOTSTRAP=0
AD_EVENT_PROCESSOR_UI_ACTIVATION=1

# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Leave empty; owner pastes JWT at /activate.
# LICENSE_MODE=file enables MCK seed coupling (sealed blobs required at runtime).
AD_EVENT_PROCESSOR_LICENSE_MODE=file
AD_EVENT_PROCESSOR_LICENSE_KEY=
# Per-release asset seal salt (64 hex chars); set on garble build host, not customer install.env unless repack.
# AD_EVENT_PROCESSOR_ASSET_SEAL_SALT=
# Sealed unified-filter.lua blob; default internal/ingestion/unified_filter_sealed.bin
# AD_EVENT_PROCESSOR_UNIFIED_FILTER_SEALED_BLOB=
# Sealed edge XDP policy blob; default internal/edge/edge_sealed.bin
# AD_EVENT_PROCESSOR_EDGE_SEALED_BLOB=
# Sealed processor CH ingest policy blob; default internal/ingestion/processor_ch_ingest_sealed.bin
# AD_EVENT_PROCESSOR_PROCESSOR_CH_INGEST_SEALED_BLOB=
# Sealed control runtime policy blob; default internal/control/control_runtime_sealed.bin
# AD_EVENT_PROCESSOR_CONTROL_RUNTIME_SEALED_BLOB=

# Optional: DNS + TLS (skip for bare IP testing)
TRACKING_DOMAIN=
ADMIN_DOMAIN=
DEFAULT_CURRENCY=USD
TIMEZONE=UTC

TELEMETRY_ENABLED=false

INGRESS_ENABLED=0
CADDY_ACME_EMAIL=

INGRESS_TLS_MODE=acme
INGRESS_TLS_CERT=/etc/caddy/certs/fullchain.pem
INGRESS_TLS_KEY=/etc/caddy/certs/privkey.pem

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Docker install mode only (install.sh docker up). Systemd bundles use bin/ from release tarball.
# AD_EVENT_PROCESSOR_USE_RELEASE_IMAGES=1
# AD_EVENT_PROCESSOR_APP_IMAGE=ghcr.io/mykhailov-ua/ad-event-processor:v0.1.0
