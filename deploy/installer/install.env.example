# ad-event-processor Installer Environment Configuration Example
# Default install: sudo bash install.sh systemd up  ->  open http://<ip>:8188/activate
# Do not set ADMIN_BOOTSTRAP_* unless AD_EVENT_PROCESSOR_CLI_BOOTSTRAP=1 below.

# CLI-only bootstrap (off by default). When 1, set ADMIN_BOOTSTRAP_EMAIL/PASSWORD and license here.
AD_EVENT_PROCESSOR_CLI_BOOTSTRAP=0
AD_EVENT_PROCESSOR_UI_ACTIVATION=1

# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Leave empty; owner pastes JWT at /activate.
AD_EVENT_PROCESSOR_LICENSE_MODE=file
AD_EVENT_PROCESSOR_LICENSE_KEY=

# Optional: DNS + TLS (skip for bare IP testing)
TRACKING_DOMAIN=
ADMIN_DOMAIN=
DEFAULT_CURRENCY=USD
TIMEZONE=UTC

TELEMETRY_ENABLED=false

INGRESS_ENABLED=0
CADDY_ACME_EMAIL=

INGRESS_TLS_MODE=acme
INGRESS_TLS_CERT=/etc/caddy/certs/fullchain.pem
INGRESS_TLS_KEY=/etc/caddy/certs/privkey.pem

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
