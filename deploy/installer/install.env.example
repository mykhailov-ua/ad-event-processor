# Copy to install.env (or deploy/installer/install.env) and edit.
# Run: bash scripts/install/bidshard-install.sh --yes

# --- Required (non-interactive) ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# --- Platform ---
TRACKING_DOMAIN=trk.example.com
DEFAULT_CURRENCY=USD
TIMEZONE=UTC
TELEMETRY_ENABLED=true

# --- Ingress / TLS (Caddy, compose profile ingress) ---
# Set INGRESS_ENABLED=1 to terminate HTTPS on the VPS (Let's Encrypt or manual certs).
INGRESS_ENABLED=0
# Email for ACME (Let's Encrypt) — required when INGRESS_TLS_MODE=acme
CADDY_ACME_EMAIL=ops@example.com
# Optional separate admin host (otherwise control stays on :8188)
ADMIN_DOMAIN=admin.example.com
# acme = automatic TLS (default); manual = mount certs under deploy/ingress/certs/
INGRESS_TLS_MODE=acme
# Manual TLS paths inside the ingress container
INGRESS_TLS_CERT=/etc/caddy/certs/fullchain.pem
INGRESS_TLS_KEY=/etc/caddy/certs/privkey.pem

# --- Stripe (optional) ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- License (optional) ---
ESPX_LICENSE_KEY=

# --- Release images (optional — skip local docker build) ---
# ESPX_USE_RELEASE_IMAGES=1
# ESPX_APP_IMAGE=ghcr.io/<owner>/bidshard:v1.0.0

# --- Stack / control (defaults match .env.example) ---
# MANAGEMENT_PORT=8188
# ADMIN_API_KEY=dev-admin-api-key-change-me
# SERVER_PORT=8181
# DB_PORT=5430
# REDIS_PASSWORD=your_redis_password_here

# --- Install behavior ---
# SKIP_PROVISION is only a CLI flag: bash scripts/install/bidshard-install.sh --skip-provision
