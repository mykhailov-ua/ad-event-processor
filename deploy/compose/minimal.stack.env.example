# Minimal stack env defaults (deploy/compose/minimal.stack.env.example).
# Append to repo-root .env before: bash scripts/dev/stack/stack.sh minimal
# Cross-ref: deploy/DEPLOY.md, docker-compose.minimal.yaml.
#
# Role:
# - Stable env knobs for minimal profile; stack.sh also exports overrides at launch.
#
# Invariants:
# - CH_ENABLED=1 (ClickHouse on); REDIS_SHARD_COUNT=1; INGRESS_ENABLED=0.
# - FRAUD_SCORING_ENABLED=false; cold-path workers disabled (CONTROL_ENABLE_*=0).
# - AD_EVENT_PROCESSOR_LICENSE_MODE=dev, LICENSE_REQUIRED=0.
# - CPU_ISOLATION_ENABLED=0 (set CPU_ISOLATION_ENABLED=1 in .env for cpu-isolation overlay).
#
# Forbidden:
# - Do not use for load-test or production (no TLS, single-shard topology only).
#
# Verify:
# cat deploy/compose/minimal.stack.env.example >> .env
# bash scripts/dev/stack/stack.sh minimal
CH_ENABLED=1
REDIS_SHARD_COUNT=1
INGEST_REDIS_SHARD_COUNT=1
REDIS_ADDRS=/run/ad-event-processor/redis/redis-0.sock
FRAUD_SCORING_ENABLED=false
FRAUD_MICROBATCH_ENABLED=false
CONTROL_ENABLE_PAYMENT=0
CONTROL_ENABLE_BILLING=0
CONTROL_ENABLE_NOTIFIER=0
CONTROL_ENABLE_MARGIN_GUARD=0
CONTROL_ENABLE_COST_SYNC=0
CONTROL_ENABLE_PLATFORM_CAMPAIGN_SYNC=0
INGRESS_ENABLED=0
CPU_ISOLATION_ENABLED=0
AD_EVENT_PROCESSOR_LICENSE_REQUIRED=0
AD_EVENT_PROCESSOR_LICENSE_MODE=dev
