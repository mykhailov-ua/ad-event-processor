[Unit]
Description=ad-event-processor stream processor
After=network-online.target ad-event-processor-control.service
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__INSTALL_ROOT__
EnvironmentFile=-/etc/ad-event-processor/secrets.env
ExecStart=__INSTALL_ROOT__/bin/processor
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
