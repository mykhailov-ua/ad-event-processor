FROM golang:1.25.12-alpine AS modules
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

FROM node:22-alpine AS web
WORKDIR /src
COPY web/ ./web/
RUN node web/scripts/build.mjs

FROM golang:1.25.12-alpine AS builder
RUN apk add --no-cache bash
COPY --from=modules /go/pkg/mod /go/pkg/mod
WORKDIR /src
COPY . .
COPY --from=web /src/web/dist ./web/dist
ARG GARBLE_SEED
ENV GARBLE_SEED=${GARBLE_SEED}
ARG ASSET_SEAL_SALT
ENV ASSET_SEAL_SALT=${ASSET_SEAL_SALT}
ENV AD_EVENT_PROCESSOR_ASSET_SEAL_SALT=${ASSET_SEAL_SALT}
ENV RELEASE_GARBLE=1
RUN bash scripts/ci/gen.sh --proto
RUN bash scripts/ci/release_garble.sh /bin tracker processor control

FROM gcr.io/distroless/static-debian12
COPY --from=builder /bin/tracker /tracker
COPY --from=builder /bin/processor /processor
COPY --from=builder /bin/control /control
USER nonroot:nonroot
ENTRYPOINT ["/tracker"]
