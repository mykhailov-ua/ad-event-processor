{
  "include": [
    "model"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "model/.venv"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "venvPath": "model",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "model",
      "extraPaths": [
        "."
      ],
      "pythonVersion": "3.12"
    }
  ]
}
