{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "runtime.path": ["?.lua", "?/init.lua", "types/?.lua"],
  "workspace.library": ["types"],
  "diagnostics.globals": ["redis", "KEYS", "ARGV", "bit"],
  "diagnostics.disable": [
    "need-check-nil",
    "undefined-field",
    "param-type-mismatch",
    "cast-local-type"
  ]
}
