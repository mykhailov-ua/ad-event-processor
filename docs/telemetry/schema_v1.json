{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espx.io/schemas/telemetry/pulse/v1.json",
  "title": "eSPX product telemetry pulse v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "binary_version",
    "window_sec",
    "accepted_events",
    "rejected_events",
    "peak_rps"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "binary_version": {
      "type": "string",
      "minLength": 1
    },
    "sku": {
      "type": "string"
    },
    "window_sec": {
      "type": "integer",
      "minimum": 60
    },
    "accepted_events": {
      "type": "integer",
      "minimum": 0
    },
    "rejected_events": {
      "type": "integer",
      "minimum": 0
    },
    "peak_rps": {
      "type": "integer",
      "minimum": 0
    },
    "dc_region": {
      "type": "string"
    }
  }
}
