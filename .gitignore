deploy/vendor/license_private.key
deploy/vendor/keys/*/license_private.key
license.jwt
.license-*.jwt

# On-prem license / mmap runtime state (not sources)
.license-spool/
*.wal

# Generated code (make gen / make proto — repo keeps sources only)
/api/gen/
/gen/

# sqlc (queries/*.sql + migrations/)
internal/*/db/*.sql.go
internal/*/db/db.go
internal/*/db/models.go
internal/*/db/querier.go
internal/domain/db/

# protobuf / vtproto (api/*.proto → internal/*/pb/)
internal/*/pb/*.pb.go
internal/*/pb/*_grpc.pb.go
internal/*/pb/*_vtproto.pb.go

# bpf2go (deploy/edge-xdp/bpf/*.c → internal/edge/)
internal/edge/bpf_edge_bpf*.go
internal/edge/*.o
deploy/edge/xdp/bpf/*.o
deploy/edge/xdp/bpf/*.disasm.txt
deploy/dev/bpf/*.o
deploy/dev/bpf/*.disasm.txt

