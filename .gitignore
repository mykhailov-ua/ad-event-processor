# Secrets & environment
.env
.env.secrets
*.env

# Build output & vendored deps
bin/*
!bin/.gitkeep
dist/release/
vendor/

# Root-level binaries (go build -o ./<name> — use bin/ instead)
/*.exe
/*-xdp
/tracker
/processor
/control
/management
/auth
/payment
/billing
/notifier
/ivt-detector
/fraud-scorer
/broker
/region-proxy
/log-shipper
/loadgen
/edge-xdp
