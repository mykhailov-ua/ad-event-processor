root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{js,ts,tsx,css,yml,yaml,json,sh,mjs}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_style = space
indent_size = 2

[*.c]
indent_style = space
indent_size = 4

[*.h]
indent_style = space
indent_size = 4
