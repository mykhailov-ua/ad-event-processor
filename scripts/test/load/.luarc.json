{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "diagnostics.globals": [
    "wrk",
    "request",
    "response",
    "setup",
    "thread",
    "done"
  ],
  "diagnostics.disable": [
    "need-check-nil",
    "undefined-field",
    "param-type-mismatch",
    "cast-local-type"
  ]
}
